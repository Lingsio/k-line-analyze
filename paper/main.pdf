dup 52 /four put
dup 105 /i put
dup 109 /m put
dup 110 /n put
dup 111 /o put
dup 49 /one put
dup 40 /parenleft put
dup 41 /parenright put
dup 43 /plus put
dup 114 /r put
dup 115 /s put
dup 126 /tilde put
dup 50 /two put
dup 120 /x put
dup 48 /zero put
readonly def
currentdict end
currentfile eexec
